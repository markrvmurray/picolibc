#!/bin/sh
#
# run-mc6809-usim6309 — picolibc test runner for HD6309 on usim09batch.
#
# Thin sibling of run-mc6809: sets USIM_HD6309=1 so usim09batch runs in
# HD6309 emulation mode, then delegates everything else (stdin/--args
# parsing, USIM_CYCLES, USIM_TIMEOUT, the rc-124 cap-hit relay) to
# run-mc6809. Single source of truth, no duplicated logic.
#
# The HD6309 cross file's exe_wrapper unless the bench is run with
# BENCH_HD6309_BACKEND=mame: the -hd6309 levels execute on USim rather
# than MAME (same -mcpu=hd6309 codegen, different backend).
#
exec env USIM_HD6309=1 "$(dirname "$0")/run-mc6809" "$@"
