# cross-clang-mc6809-unknown-decb.txt — picolibc for CoCo Disk Extended
# Color BASIC, generated by gen-mc6809-cross.sh.  Do not edit: edit the
# .in and re-run the generator.
#
# A DECB program is what LOADM puts in memory and EXEC calls.  The start-up
# code and the linker script come from the LLVM-MC6809 DECB runtime, which
# the clang driver adds for this triple, so nothing here has to name them.
#
# There is **no exe_wrapper**, and so no way to run the tests: this tree has
# no CoCo emulator.  The library builds and the tests link; whether they
# work is unknown until somebody runs one on a machine.
#
# Generator placeholders use %%...%% so they cannot clash with meson's
# @...@ tokens:
#
#   %%LLVM_BIN%%
[binaries]
c = ['%%LLVM_BIN%%/clang', '--target=mc6809-unknown-decb']
cpp = ['%%LLVM_BIN%%/clang', '--target=mc6809-unknown-decb']
ar = '%%LLVM_BIN%%/llvm-ar'
nm = '%%LLVM_BIN%%/llvm-nm'
strip = '%%LLVM_BIN%%/llvm-strip'

[host_machine]
system = 'decb'
cpu_family = 'mc6809'
cpu = 'mc6809'
endian = 'big'

[properties]
skip_sanity_check = true
