#!/bin/sh
#
# run-mc6809-os9 — picolibc test runner for OS-9 / NitrOS-9 on usim09pt.
#
# Usage: run-mc6809-os9 [--fp-module FILE] [--toolchain-ref FILE] <module>
#            [--stdin "string"] [--args "args"]
#
# The program is an OS-9 program module (clang --target=mc6809-unknown-os9).
# Each run boots NitrOS-9 from the IDE image NITROS9_BOOT_DSK (i0) with the
# module on a fresh IDE image (j0), drives the shell over the console
# (scripted --input: log in, `chx /j0/cmds`, run the program, echo a
# sentinel), and relays the program's console output on stdout.  The exit
# status is the one the shell reports: NitrOS-9 prints `Error #nnn` for a
# non-zero F$Exit status, so that number is this script's exit code, 0
# otherwise -- which is what meson's test harness needs (77 = skip, 99 =
# error).  --stdin text follows the command line on the console, one line
# at a time; --args are the command's parameter words.
#
# Environment:
#   NITROS9_USIM09PT     the emulator (default: usim09pt on the path)
#   NITROS9_BOOT_DSK     a bootable NitrOS-9 IDE (flat) image   [required]
#   NITROS9_FIRMWARE     the Pico-Thing boot firmware (.srec)   [required]
#   OS9_TOOL             ToolShed's os9 (default: os9 on the path)
#   NITROS9_INPUT_FIRST  cycles before the first console byte (login prompt
#                        up; default 78000000)
#   NITROS9_TIMEOUT      instruction cap for the whole run (default 2e9)
#   NITROS9_WALL_SECONDS wall-clock cap (default 600)
#   USIM_CYCLES=1        report `cycles=<N>` on stderr (the program's own
#                        instructions cannot be separated from the boot's;
#                        this is the whole run)
#   NITROS9_SETIME       date to set the guest clock to (default: the host's;
#                        `off` leaves the kernel's 1986 epoch)
#   NITROS9_USIM_EXTRA   extra usim09pt options (tracing, --brk-gated ...)
#   MC6809_FP_MODULE     the FPO9 floating-point module to put on the disk
#                        (the cross file passes --fp-module; a program doing
#                        floating point links it at start-up)
#   KEEP_OS9_WORKDIR=1   keep the per-run working directory
#

USIM="${NITROS9_USIM09PT:-usim09pt}"
OS9="${OS9_TOOL:-os9}"

# A run against a stale binary is worse than no run: it passes or fails for
# reasons that stopped being true when the compiler was rebuilt, and ninja
# has no edge from a test to the compiler that built it, so nothing else
# notices.  Refuse, and name the one command that fixes it.
check_freshness() {
  _ref="$1"; _bin="$2"
  [ "${MC6809_ALLOW_STALE:-0}" = 1 ] && return 0
  [ -n "$_ref" ] && [ -e "$_ref" ] && [ -e "$_bin" ] || return 0
  if [ "$_ref" -nt "$_bin" ]; then
    echo "$(basename "$0"): $(basename "$_bin") is older than the toolchain" >&2
    echo "  ($_ref has changed since it was built)" >&2
    echo "  run: scripts/mc6809-refresh <builddir>" >&2
    echo "  (MC6809_ALLOW_STALE=1 runs it anyway)" >&2
    exit 99
  fi
  return 0
}

stdin=""
args=""
module=""
fp_module="${MC6809_FP_MODULE:-}"
toolchain_ref="${MC6809_TOOLCHAIN_REF:-}"
done=0
while [ $# -gt 0 -a $done -eq 0 ]; do
  case "$1" in
    --fp-module) fp_module="$2"; shift 2 ;;
    --toolchain-ref) toolchain_ref="$2"; shift 2 ;;
    --stdin)     stdin="$2";     shift 2 ;;
    --args)      args="$2";      shift 2 ;;
    *)
      if [ -z "$module" ]; then
        module="$1"; shift
      else
        done=1
      fi
      ;;
  esac
done

if [ -z "$module" ]; then
  echo "usage: run-mc6809-os9 <module> [--stdin string] [--args string]" >&2
  exit 99
fi

# The OS-9 runtime sits beside the floating-point module the cross file
# passes, so either one dates the toolchain the program was built against.
[ -n "$toolchain_ref" ] || [ -z "$fp_module" ] ||
  toolchain_ref="$(dirname "$fp_module")/libclang_rt.os9.a"
check_freshness "$toolchain_ref" "$module"

: "${NITROS9_BOOT_DSK:?need NITROS9_BOOT_DSK (a NitrOS-9 IDE boot image)}"
: "${NITROS9_FIRMWARE:?need NITROS9_FIRMWARE (the Pico-Thing .srec)}"
: "${NITROS9_INPUT_FIRST:=78000000}"
: "${NITROS9_TIMEOUT:=2000000000}"
: "${NITROS9_WALL_SECONDS:=600}"

# OS-9 command names: letters, digits, underscore; at most 29 characters.
name=$(basename "$module")
name=$(printf '%s' "$name" | tr -cd 'A-Za-z0-9_' | cut -c1-29)
[ -n "$name" ] || name=prog

workdir=$(mktemp -d "${TMPDIR:-/tmp}/os9run.XXXXXX")
cleanup() { [ "${KEEP_OS9_WORKDIR:-0}" = 1 ] || rm -rf "$workdir"; }
trap cleanup EXIT

boot="$workdir/boot.dsk"
disk="$workdir/test.dsk"
log="$workdir/usim.log"

cp "$NITROS9_BOOT_DSK" "$boot"
"$OS9" format "$disk" -e -l4096 -q -nTEST >/dev/null
"$OS9" makdir "$disk,CMDS" >/dev/null
"$OS9" copy -r "$module" "$disk,CMDS/$name" >/dev/null
"$OS9" attr -q -e -pe -pr "$disk,CMDS/$name" >/dev/null
# A program that does floating point links the FPO9 module at start-up and
# loads it from the execution directory when nothing else has it yet.
if [ -n "$fp_module" ] && [ -f "$fp_module" ]; then
  "$OS9" copy -r "$fp_module" "$disk,CMDS/FPO9" >/dev/null
  "$OS9" attr -q -e -pe -pr "$disk,CMDS/FPO9" >/dev/null
fi

# The console script: three CRs log in (the blank-name superuser), then
# the command, its stdin lines, and the sentinel.  Backslash-r sequences
# are usim09pt's notation; the command's own output is scraped between the
# command echo and the sentinel.
cmd="$name"
[ -n "$args" ] && cmd="$name $args"
input="\\r\\r\\r"
# The kernel's clock starts at its epoch (1986), which anything comparing
# time() against a modern date fails on; set it from the host unless told
# otherwise (NITROS9_SETIME=off).  Before chx, while the system commands are
# still the execution directory.
if [ "${NITROS9_SETIME:-auto}" != off ]; then
  setime=$NITROS9_SETIME
  [ "${setime:-auto}" = auto ] && setime=$(date "+%Y/%m/%d %H:%M:%S")
  input="${input}setime $setime\\r"
fi
input="${input}chx /j0/cmds\\rchd /j0\\r$cmd\\r"
if [ -n "$stdin" ]; then
  # Each stdin line becomes a console line; a trailing newline is implied.
  input="$input$(printf '%s' "$stdin" | sed 's/$/\\r/' | tr -d '\n')"
fi
input="${input}echo CIDONE\\r"

cycles_flag=""
[ "${USIM_CYCLES:-0}" = 1 ] && cycles_flag="--cycles"

(cd "$workdir" && "$USIM" --timeout="$NITROS9_TIMEOUT" $cycles_flag ${NITROS9_USIM_EXTRA:-} \
    --input-first="$NITROS9_INPUT_FIRST" --input-step=500000 \
    --input="$input" -f "$workdir/picothing.fram" \
    -d "$boot" -D "$disk" "$NITROS9_FIRMWARE" >"$log" 2>"$workdir/usim.err") &
pid=$!
waited=0
while kill -0 "$pid" 2>/dev/null; do
  if grep -aq 'CIDONE' "$log" 2>/dev/null; then
    break
  fi
  if [ "$waited" -ge "$NITROS9_WALL_SECONDS" ]; then
    break
  fi
  sleep 1
  waited=$((waited + 1))
done
kill "$pid" 2>/dev/null || true
wait "$pid" 2>/dev/null
usim_rc=$?

grep -a 'cycles=' "$workdir/usim.err" >&2 || true

if ! grep -aq 'CIDONE' "$log"; then
  # No sentinel: the run hung or the cap hit.  124 is the timeout
  # convention the tally harness understands.
  echo "run-mc6809-os9: NitrOS-9 run did not reach the sentinel ($name)" >&2
  tr -d '\000' <"$log" | tail -c 2000 >&2
  exit 124
fi

# The program's output: the console between the command echo and the
# sentinel command, without the NULs the console emits and with OS-9's CR
# line ends as newlines.  The shell's `Error #nnn` (after a failing
# command) gives the exit status; it is not part of the output.
out="$workdir/out.txt"
tr -d '\000' <"$log" | tr '\r' '\n' |
  awk -v cmd="$cmd" '
    # The shell prompt precedes the echoed command on the same line, so
    # match the line that ends with the command text, after the chd.
    state == 0 && index($0, "chd /j0") { state = 1; next }
    state == 1 { if (substr($0, length($0) - length(cmd) + 1) == cmd) state = 2; next }
    state == 2 { if (index($0, "echo CIDONE")) { exit } print }
  ' >"$out"
# The kernel's F$PErr says `ERROR #nnn`; Shell+ says `Error #nnn - text`.
status=0
if grep -q '^[Ee][Rr][Rr][Oo][Rr] #[0-9][0-9]*' "$out"; then
  status=$(grep '^[Ee][Rr][Rr][Oo][Rr] #[0-9][0-9]*' "$out" | tail -1 |
           sed 's/^[Ee][Rr][Rr][Oo][Rr] #0*\([0-9]*\).*/\1/')
  [ -n "$status" ] || status=1
fi
grep -v '^[Ee][Rr][Rr][Oo][Rr] #[0-9][0-9]*' "$out"
exit "$status"
