#!/bin/sh
#
# run-mc6809 — picolibc test runner for MC6809 (usim09batch)
#
# Usage: run-mc6809 [--toolchain-ref FILE] <elf> [--stdin "string"] [--args "args"]
#
# Since usim09batch's load_elf landed (commit 1d0610d for the PT_LOAD
# walk + reset-vector $FFFE ← _start fallback; commit 2734c8d for the
# Bug #331 SWI3 $FFF2 ← __swi3_trap fallback), USim reads ELF files
# directly and wires both vectors from the ELF symbol table. No
# host-side hex conversion or vector inject is needed.
#

USIM="${USIM09BATCH:-usim09batch}"

# A run against a stale binary is worse than no run: it passes or fails for
# reasons that stopped being true when the compiler was rebuilt, and ninja
# has no edge from a test to the compiler that built it, so nothing else
# notices.  Refuse, and name the one command that fixes it.
check_freshness() {
  _ref="$1"; _bin="$2"
  [ "${MC6809_ALLOW_STALE:-0}" = 1 ] && return 0
  [ -n "$_ref" ] && [ -e "$_ref" ] && [ -e "$_bin" ] || return 0
  if [ "$_ref" -nt "$_bin" ]; then
    echo "$(basename "$0"): $(basename "$_bin") is older than the toolchain" >&2
    echo "  ($_ref has changed since it was built)" >&2
    echo "  run: scripts/mc6809-refresh <builddir>" >&2
    echo "  (MC6809_ALLOW_STALE=1 runs it anyway)" >&2
    exit 99
  fi
  return 0
}

elf=""
toolchain_ref="${MC6809_TOOLCHAIN_REF:-}"

stdin=""
args=""
done=0
while [ $# -gt 0 -a $done -eq 0 ]; do
  case "$1" in
    --toolchain-ref)
      toolchain_ref="$2"
      shift 2
      ;;
    --stdin)
      stdin="$2"
      shift 2
      ;;
    --args)
      args="$2"
      shift 2
      ;;
    *)
      if [ -z "$elf" ]; then
        elf="$1"
        shift
      else
        done=1
      fi
      ;;
  esac
done

if [ -z "$elf" ]; then
  echo "usage: run-mc6809 [--toolchain-ref file] <elf> [--stdin string] [--args string]" >&2
  exit 1
fi

check_freshness "$toolchain_ref" "$elf"

# USIM_CYCLES=1 opts into canonical-cycle reporting; usim09batch then
# emits 'cycles=<N>' on stderr which the tally harness picks up.
cycles_flag=""
if [ "${USIM_CYCLES:-0}" = "1" ]; then
  cycles_flag="--cycles"
fi
# USIM_HD6309=1 selects usim09batch's HD6309 emulation (for -mcpu=hd6309
# binaries). Opt-in so this same wrapper still serves the 6809 levels
# unchanged; the run-mc6809-usim6309 sibling sets it for the bench's
# HD6309 levels when BENCH_HD6309_BACKEND=usim.
hd6309_flag=""
if [ "${USIM_HD6309:-0}" = "1" ]; then
  hd6309_flag="--hd6309"
fi
# Default cap 2B instructions (4x headroom over the slow string tests
# at ~500M). usim returns rc 124 on cap-hit (GNU timeout convention);
# we relay it unchanged so the python harness can reclassify
# FAIL -> TIMEOUT.
echo "$stdin" | $USIM --timeout="${USIM_TIMEOUT:-2000000000}" $cycles_flag $hd6309_flag "$elf"
