#!/bin/sh
# check-mc6809-toolchain — does an installed MC6809 toolchain work?
#
# Usage: check-mc6809-toolchain [--corpus [--corpus-dir DIR]] [PREFIX]
#                                               (or set MC6809_TOOLCHAIN)
#
# Compiles a handful of ordinary C programs with nothing but `--target`, the
# way somebody who has unpacked a toolchain would, and runs each one: bare
# metal on USim, OS-9 on a real NitrOS-9 boot.  Nothing here names a library,
# a linker script or an include path, which is the whole point -- if the
# driver cannot find its own sysroot, this fails.
#
# This is the acceptance test for a bundle.  It is deliberately not the
# picolibc test suite as the suite is normally run: that run links the libc.a
# it has just built, so it exercises the compiler but never the *installed*
# library.  `--corpus` closes that gap the other way round -- it takes the
# suite's programs as source and compiles them against the bundle, one plain
# clang command each, no meson and no build tree.  That is the difference
# between "the compiler in the tarball works" and "the tarball works".
#
#   NITROS9_LEVEL   which NitrOS-9 the OS-9 cases boot (default 2)
#   MC6809_MAMECOCO3  a CoCo-capable MAME (mamecoco3-headless) for the DECB
#                     cases; without it they report "not checked" rather than
#                     passing or failing, since a CoCo needs Tandy's ROMs
#   USIM09BATCH     the bare-metal simulator (default: usim09batch on PATH)
#   MC6809_CHECK_ALLOW_UNRUNNABLE
#                   accept a run in which some cases could not be attempted
#                   at all -- the OS-9 ones with no NitrOS-9 image to boot.
#                   Without it such a run exits 2, which is the right
#                   default: a check that did not run must not read green.
#                   Set it only where the machines cannot exist, and read
#                   the not-run count that every run now prints.
set -u

CORPUS=
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
while [ $# -gt 0 ]; do
  case "$1" in
    # No optional argument here on purpose: `--corpus DIR PREFIX` and
    # `--corpus PREFIX` cannot both be read correctly, and the wrong reading
    # silently checks the wrong thing.
    --corpus)     CORPUS=$SCRIPT_DIR/../test; shift ;;
    --corpus-dir) CORPUS=$2; shift 2 ;;
    -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
    *) break ;;
  esac
done

PREFIX=${1:-${MC6809_TOOLCHAIN:-}}
[ -n "$PREFIX" ] || { echo "usage: $0 PREFIX  (or set MC6809_TOOLCHAIN)" >&2; exit 2; }
CLANG=$PREFIX/bin/clang
CLANGXX=$PREFIX/bin/clang++
[ -x "$CLANG" ] || { echo "$0: no clang at $CLANG" >&2; exit 2; }
[ -x "$CLANGXX" ] || { echo "$0: no clang++ at $CLANGXX" >&2; exit 2; }

USIM09BATCH=${USIM09BATCH:-usim09batch}
# `timeout` if the system has one; without it a wedged program hangs the run,
# which is worth knowing about but not worth refusing to run over.
if command -v timeout >/dev/null 2>&1; then
  TIMEOUT="timeout ${MC6809_CHECK_TIMEOUT:-120}"
else
  TIMEOUT=
fi

# What this needs besides the bundle.  A missing simulator is not a broken
# bundle, and must not be reported as one: without it nothing here can be
# checked at all, so say which piece is absent and stop.  The same rule as
# the bench's OS-9 gate -- a check that did not run must never read as green.
missing=
command -v "$USIM09BATCH" >/dev/null 2>&1 \
  || missing="$missing\n  $USIM09BATCH (USim's batch simulator; ~/GitHub/usim,\
 or set USIM09BATCH)"
command -v "${NITROS9_USIM09PT:-usim09pt}" >/dev/null 2>&1 \
  || missing="$missing\n  usim09pt (the Pico-Thing simulator, for the OS-9 cases)"
if [ -n "$missing" ]; then
  # shellcheck disable=SC2059
  printf "$0: cannot check a toolchain without:$missing\n" >&2
  exit 2
fi

# Floating point on OS-9 is a module loaded at start-up, and this toolchain
# ships it.  A program that does no floating point neither looks for it nor
# minds that it is there, so it costs nothing to always offer it.
_res=$("$CLANG" -print-resource-dir 2>/dev/null || true)
if [ -z "${MC6809_FP_MODULE:-}" ] && [ -f "$_res/lib/mc6809-unknown-os9/FPO9" ]
then
  MC6809_FP_MODULE=$_res/lib/mc6809-unknown-os9/FPO9
  export MC6809_FP_MODULE
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/mc6809-check.XXXXXX")
trap 'rm -rf "$work"' EXIT

pass=0; fail=0; env_error=0; notrun=0

# case NAME TRIPLE EXPECTED [CFLAGS] <<'EOF' ... source ... EOF
run_case() {
  name=$1; triple=$2; expect=$3; extra=${4:-}
  # Code built for the 6309 needs a 6309 to run on.  Both simulators take the
  # same switch for it.
  sim_extra=; os9_cpu=${NITROS9_CPU:-6809}
  case "$extra" in *hd6309*) sim_extra=--hd6309; os9_cpu=6309 ;; esac
  cat > "$work/$name.c"
  # A simulator needs a start-up that calls exit(); picolibc's plain crt0 does
  # not, because a program on hardware does not return from main.
  crt0=
  case "$triple" in *os9) ;; *) crt0=-mcrt0=semihost ;; esac
  # shellcheck disable=SC2086
  if ! "$CLANG" --target="$triple" $crt0 $extra "$work/$name.c" \
        -o "$work/$name.bin" > "$work/$name.build" 2>&1; then
    echo "FAIL $name ($triple): did not build"
    sed 's/^/    /' "$work/$name.build" | head -5
    fail=$((fail + 1)); return
  fi
  # Closed stdin and a cap on the clock: a simulator that inherits this
  # script's input waits for it, and a program that never finishes must fail
  # the check rather than hang it.
  case "$triple" in
    *os9) got=$(NITROS9_LEVEL=${NITROS9_LEVEL:-2} NITROS9_CPU=$os9_cpu \
                $TIMEOUT "$SCRIPT_DIR/run-mc6809-os9" "$work/$name.bin" \
                2>"$work/$name.err" </dev/null) ; rc=$?
          # The runner works out the boot image itself and says so when it
          # cannot.  That is a missing NitrOS-9, not a broken toolchain.
          if grep -q "need NITROS9_\|NITROS9_CPU is" "$work/$name.err" \
               2>/dev/null; then
            echo "----  $name ($triple): not checked -- \
$(sed -n '1s/.*: //p' "$work/$name.err")"
            env_error=1; notrun=$((notrun + 1)); return
          fi ;;
    *)    # shellcheck disable=SC2086
          got=$($TIMEOUT "$USIM09BATCH" $sim_extra "$work/$name.bin" \
                2>/dev/null </dev/null) ; rc=$? ;;
  esac
  # 124 is what `timeout` reports when it had to kill the thing.  A program
  # that printed the right answer and then never stopped has not passed:
  # reading its output and calling it done is how a check comes to take
  # minutes per case and report ok.
  if [ "$rc" = 124 ]; then
    echo "FAIL $name ($triple): did not terminate"
    fail=$((fail + 1)); return
  fi
  # The console adds NULs and line endings of its own; compare the substance.
  got=$(printf '%s' "$got" | tr -d '\000\r' | sed '/^$/d')
  if [ "$got" = "$expect" ]; then
    echo "ok   $name ($triple)"
    pass=$((pass + 1))
  else
    echo "FAIL $name ($triple): got [$got] want [$expect]"
    fail=$((fail + 1))
  fi
}

# The library variants.  Two things have to be true of each and only one of
# them shows up in a program's output: the link must use the variant's own
# directory, and the program must run.  A default library links and runs
# perfectly well in most of these cases -- a 6809 libc runs on a 6309, and an
# integer libc links a program that never prints a float -- so a bundle whose
# multilib rules never matched would still print the right answer while
# quietly shipping the wrong library.  Hence the link line is inspected for
# the directory as well.
#
# variant TRIPLE "FLAGS" DIR EXPECTED <<'EOF' ... source ... EOF
variant() {
  vtriple=$1; vflags=$2; vdir=$3; vexpect=$4
  vsrc=$(cat)

  # shellcheck disable=SC2086
  if "$CLANG" --target="$vtriple" $vflags -### -x c - -o "$work/v.bin" \
        < /dev/null 2>&1 | grep -q "clang-runtimes/$vtriple/$vdir\"" ; then
    echo "ok   $vdir library ($vtriple)"
    pass=$((pass + 1))
  else
    echo "FAIL $vdir library ($vtriple): the link does not use $vdir/"
    fail=$((fail + 1))
  fi

  # Not `printf ... | run_case`: the right-hand side of a pipe is a subshell,
  # and every count it makes -- pass, fail, not-run, and the flag that says a
  # case could not be attempted -- is discarded when it returns.  Twelve
  # cases reported into that void, so a variant that failed still left
  # fail=0.  A file keeps run_case in this shell.
  printf '%s\n' "$vsrc" > "$work/variant.c"
  run_case "$vdir" "$vtriple" "$vexpect" "$vflags" < "$work/variant.c"
}

check_variants() {
  for triple in mc6809-unknown-unknown mc6809-unknown-os9; do
    variant "$triple" "-mcpu=hd6309" hd6309 "hello from 6309" <<'EOF'
#include <stdio.h>
int main(void) { printf("hello from %d\n", 6309); return 0; }
EOF

    # The floating-point libraries: `%f` prints a number rather than the
    # literal `*float*`, and sqrt links.  On OS-9 the arithmetic comes from
    # the FPO9 module, on bare metal from the same ROM linked into the
    # program.
    for flags in "-mlibc=float:fp" "-mcpu=hd6309 -mlibc=float:hd6309-fp"; do
      variant "$triple" "${flags%:*}" "${flags##*:}" "8.000000 4.000000" <<'EOF'
#include <stdio.h>
#include <math.h>
int main(void) { printf("%f %f\n", 3.5 * 2.0 + 1.0, sqrt(16.0)); return 0; }
EOF
    done
  done
}

check_variants

# DECB can be built but not run: there is no CoCo emulator here.  Checking
# that it links and comes out wrapped in the LOADM/EXEC envelope is not the
# same as checking it works, and is not claimed to be -- but a bundle whose
# DECB half does not link is broken, and that this does catch.
# C++.  Not a standard library -- there is none, and libc++ would not fit --
# but the language over the C library: the headers under their C++ names, and
# the handful of symbols the compiler emits calls to.  One program uses all
# of them, because each is easy to leave out and hard to notice missing.
check_cxx() {
  for triple in mc6809-unknown-unknown mc6809-unknown-os9; do
    crt0=; case "$triple" in *os9) ;; *) crt0=-mcrt0=semihost ;; esac
    cat > "$work/cxx.cpp" <<'PROG'
#include <cstdio>
#include <cstring>
struct Counter {
  static int live;
  Counter() { ++live; }
  virtual ~Counter() { --live; }
  virtual const char *name() const { return "Counter"; }
};
int Counter::live = 0;
struct Named : Counter { const char *name() const override { return "Named"; } };
static Counter global;                       // a global with a constructor
template <class T> static T twice(T v) { return v + v; }
int main() {
  Counter *c = new Named;                    // operator new
  const char *n = c->name();                 // virtual dispatch
  delete c;                                  // virtual dtor -> sized delete
  static const char *s = "statics";          // guard functions
  char buf[16];
  std::strcpy(buf, s);
  std::printf("%s %s %d %d\n", n, buf, twice(21), Counter::live);
  return 0;
}
PROG
    # shellcheck disable=SC2086
    if ! "$CLANGXX" --target="$triple" $crt0 -Os "$work/cxx.cpp" \
          -o "$work/cxx.bin" > "$work/cxx.build" 2>&1; then
      echo "FAIL c++ ($triple): did not build"
      sed 's/^/    /' "$work/cxx.build" | head -4
      fail=$((fail + 1)); continue
    fi
    case "$triple" in
      *os9) got=$(NITROS9_LEVEL=${NITROS9_LEVEL:-2} $TIMEOUT \
                  "$SCRIPT_DIR/run-mc6809-os9" "$work/cxx.bin" \
                  2>"$work/cxx.err" </dev/null)
            # No NitrOS-9 to boot is a missing machine, not a broken C++.
            # Without this the case reports FAIL and blames the toolchain.
            if grep -q "need NITROS9_\|NITROS9_CPU is" "$work/cxx.err" \
                 2>/dev/null; then
              echo "----  c++ ($triple): not checked -- \
$(sed -n '1s/.*: //p' "$work/cxx.err")"
              env_error=1; notrun=$((notrun + 1)); continue
            fi ;;
      *)    got=$($TIMEOUT "$USIM09BATCH" "$work/cxx.bin" \
                  2>/dev/null </dev/null) ;;
    esac
    got=$(printf '%s' "$got" | tr -d '\000\r' | sed '/^$/d')
    if [ "$got" = "Named statics 42 1" ]; then
      echo "ok   c++ ($triple)"
      pass=$((pass + 1))
    else
      echo "FAIL c++ ($triple): got [$got] want [Named statics 42 1]"
      fail=$((fail + 1))
    fi
  done

  # The two the toolchain does not have, refused where they are written
  # rather than at link time by a mangled name.
  printf 'int main() { try { throw 1; } catch (int) { } return 0; }\n' \
    > "$work/eh.cpp"
  if "$CLANGXX" --target=mc6809-unknown-unknown -c "$work/eh.cpp" \
        -o "$work/eh.o" > "$work/eh.build" 2>&1; then
    echo "FAIL c++ exceptions: accepted, and there is no unwinder"
    fail=$((fail + 1))
  else
    echo "ok   c++ exceptions: refused at compile time"
    pass=$((pass + 1))
  fi
}

check_cxx

check_decb() {
  cat > "$work/decb.c" <<'PROG'
#include <stdio.h>
int main(void) { printf("hello\n"); return 0; }
PROG
  if ! "$CLANG" --target=mc6809-unknown-decb "$work/decb.c" \
        -o "$work/decb.bin" > "$work/decb.build" 2>&1; then
    echo "FAIL decb (mc6809-unknown-decb): did not build"
    sed 's/^/    /' "$work/decb.build" | head -5
    fail=$((fail + 1)); return
  fi
  # $00, then two bytes of length, then the load address; and the last five
  # bytes are $FF, $0000 and the exec address.
  head=$(od -An -N1 -tx1 "$work/decb.bin" | tr -d ' \n')
  tail=$(od -An -j $(( $(wc -c < "$work/decb.bin") - 5 )) -N1 -tx1 \
            "$work/decb.bin" | tr -d ' \n')
  if [ "$head" = "00" ] && [ "$tail" = "ff" ]; then
    echo "ok   decb (mc6809-unknown-decb): links, LOADM envelope (not run)"
    pass=$((pass + 1))
  else
    echo "FAIL decb (mc6809-unknown-decb): envelope is [$head ... $tail]"
    fail=$((fail + 1))
  fi
}

for triple in mc6809-unknown-unknown mc6809-unknown-os9; do
  run_case hello "$triple" "hello, world" <<'EOF'
#include <stdio.h>
int main(void) { printf("hello, world\n"); return 0; }
EOF

  run_case heap "$triple" "toolchain 6809" <<'EOF'
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
int main(void) {
  char *p = malloc(64);
  if (!p) return 1;
  strcpy(p, "toolchain");
  printf("%s %d\n", p, 6809);
  free(p);
  return 0;
}
EOF

  run_case arith "$triple" "42 7 1000000" <<'EOF'
#include <stdio.h>
static long mul(long a, long b) { return a * b; }
int main(void) {
  int a = 6, b = 7;
  printf("%d %d %ld\n", a * b, b, mul(1000L, 1000L));
  return 0;
}
EOF
done

check_decb

# DECB, actually run.  This needs a CoCo, which is a separate MAME build with
# Tandy's ROMs, and ToolShed's `decb` to write a Disk BASIC floppy -- neither
# ships with the toolchain and neither can.  When they are absent the cases
# say so and are neither passed nor failed; when they are present both
# processors are run, because everything about this target was found by
# running it.
#
# What it costs: about a minute and a half of emulated time per case, nearly
# all of it BASIC's keyboard accepting a few characters a second.
MAMECOCO3=${MC6809_MAMECOCO3:-$(command -v mamecoco3-headless 2>/dev/null)}

decb_ready() {
  [ -n "$MAMECOCO3" ] && [ -x "$MAMECOCO3" ] || return 1
  command -v decb >/dev/null 2>&1 || return 1
  # The ROMs are Tandy's; MAME refuses to start without them, and it looks
  # for them relative to the working directory rather than to itself -- so
  # this asks from where they live.  (`coco3h` wants its own name: MAME will
  # not fall back to coco3.zip even though the ROM is the same.)
  ( cd "$(dirname "$MAMECOCO3")" && ./mamecoco3 -verifyroms "$1" ) >/dev/null 2>&1
}

# decb_run MACHINE CFLAGS -> prints the CoCo's text screen
decb_run() {
  _machine=$1; _flags=$2
  # The VDG has no lowercase -- BASIC stores it as inverse-video uppercase --
  # so the marker is uppercase and the comparison never sees case.
  cat > "$work/decb.c" <<'PROG'
#include <stdio.h>
int main(void) { long a = 100000L; printf("DECB RAN %ld\n", a / 7); return 0; }
PROG
  # shellcheck disable=SC2086
  "$CLANG" --target=mc6809-unknown-decb $_flags -Os "$work/decb.c" \
      -o "$work/decb.bin" > "$work/decb.build" 2>&1 || return 2
  rm -f "$work/decb.dsk"
  decb dskini "$work/decb.dsk" >/dev/null 2>&1 || return 2
  decb copy -2 -b "$work/decb.bin" "$work/decb.dsk,HELLO.BIN" >/dev/null 2>&1 || return 2

  # One short line at a time: MAME's keyboard queue is fixed-size and a CoCo
  # types slowly, so a single long autoboot command loses everything after
  # the first Enter.  CLEAR moves BASIC below the program, without which the
  # heap has nowhere to go and printf cannot get a buffer.
  cat > "$work/decb.lua" <<'LUA'
local nat = manager.machine.natkeyboard
emu.wait(6);  nat:post('CLEAR 200,&H3EFF\n')
emu.wait(30); nat:post('LOADM"HELLO"\n')
emu.wait(25); nat:post('EXEC\n')
emu.wait(20)
local mem = manager.machine.devices[":maincpu"].spaces["program"]
for row = 0, 15 do
  local line = ""
  for col = 0, 31 do
    local b = mem:read_u8(0x0400 + row * 32 + col)
    local c
    if b >= 0x60 and b <= 0x7F then c = b - 0x40
    elseif b >= 0x40 and b <= 0x5F then c = b
    elseif b >= 0x20 and b <= 0x3F then c = b + 0x20
    else c = b + 0x40 end
    line = line .. string.char(c)
  end
  print("SCREEN|" .. line)
end
LUA
  # From the emulator's own directory, for the ROMs; every path handed to it
  # is absolute.
  ( cd "$(dirname "$MAMECOCO3")" &&
    "$MAMECOCO3" --machine="$_machine" -1 "$work/decb.dsk" --no-snap 95 \
        -- -autoboot_script "$work/decb.lua" ) 2>/dev/null |
    # The emulator's own output is not text; C locale so sed treats it as
    # bytes rather than refusing the stream as an illegal UTF-8 sequence.
    LC_ALL=C sed -n 's/^SCREEN|//p'
}

check_decb_run() {
  for pair in "coco3:" "coco3h:-mcpu=hd6309"; do
    machine=${pair%%:*}; flags=${pair#*:}
    label="decb run ($machine${flags:+, $flags})"
    if ! decb_ready "$machine"; then
      echo "---- $label: not checked -- needs mamecoco3-headless, its Tandy \
ROMs and ToolShed's decb"
      notrun=$((notrun + 1))
      continue
    fi
    screen=$(decb_run "$machine" "$flags")
    case "$screen" in
      *"DECB RAN 14285"*)
        # And BASIC has to survive it: OK below the output, not a cleared
        # screen, which is what a program that wrecks the interpreter leaves.
        if printf '%s' "$screen" | grep -q "OK"; then
          echo "ok   $label"
          pass=$((pass + 1))
        else
          echo "FAIL $label: ran, but BASIC did not come back"
          fail=$((fail + 1))
        fi ;;
      "") echo "FAIL $label: no screen (did MAME start?)"
          sed 's/^/       /' "$work/decb.err" 2>/dev/null | tail -3
          fail=$((fail + 1)) ;;
      *)  echo "FAIL $label: wanted DECB RAN 14285, screen was:"
          printf '%s\n' "$screen" | grep -v "^ *$" | sed 's/^/       /' | head -6
          fail=$((fail + 1)) ;;
    esac
  done
}

check_decb_run

# The friendly names, which are what somebody who unpacked this would type.
# They are symlinks, and clang reads the target off its own name -- so this
# checks both that they exist and that the sysroot is findable under the
# triple each name computes, which is not the same triple in every case.
check_names() {
  for name in mc6809-clang mc6809-os9-clang mc6809-decb-clang \
             mc6809-clang++ mc6809-os9-clang++ mc6809-decb-clang++; do
    if [ ! -x "$PREFIX/bin/$name" ]; then
      echo "FAIL $name: not in the toolchain"
      fail=$((fail + 1)); continue
    fi
    printf 'int main(void) { return 0; }\n' > "$work/name.c"
    if "$PREFIX/bin/$name" "$work/name.c" -o "$work/name.bin" \
          > "$work/name.build" 2>&1; then
      echo "ok   $name"
      pass=$((pass + 1))
    else
      echo "FAIL $name: did not build"
      sed 's/^/    /' "$work/name.build" | head -4
      fail=$((fail + 1))
    fi
  done
}

# What a build system makes of `clang --version`.  Meson, and others, take the
# first dotted number in that line as the compiler's version -- so a vendor
# string carrying a release number ahead of "clang version 24.0.0" makes every
# meson project believe this is clang 1.0 and refuse to build with it, which
# is exactly how a rehearsal of the 1.0 release failed.  A release number
# belongs after the version, in the parentheses.
check_version_banner() {
  banner=$("$CLANG" --version | head -1)
  # The same rule meson's search_version applies: the first dotted number in
  # the line wins, wherever it appears.
  first=$(printf '%s' "$banner" | tr ' ' '\n' |
          grep -m1 -E '^[0-9]{1,2}(\.[0-9]+)+')
  real=$("$CLANG" --version | sed -n 's/.*clang version \([0-9][^ ]*\).*/\1/p')
  case "$real" in "$first"*) ;; *) first_bad=1 ;; esac
  if [ -z "${first_bad:-}" ]; then
    echo "ok   version banner: a build system reads $first"
    pass=$((pass + 1))
  else
    echo "FAIL version banner: a build system reads [$first], not [$real]"
    echo "       $banner"
    echo "       a release number before \"clang version\" is read as the"
    echo "       compiler's own version; put it after, in the parentheses"
    fail=$((fail + 1))
  fi
}

check_version_banner

check_names

# ------------------------------------------------------------------ corpus
# picolibc's own test programs, compiled against the installed library with
# one plain clang command each.  Three things are deliberately not attempted:
#
#   * tests that need a filesystem, because a bare-metal semihost has none.
#     The list lives in run-mc6809-tests, which is the harness that owns it;
#     asking it beats keeping a second copy here that drifts.
#   * tests that are only #included by another test -- they are not programs.
#   * anything that fails to link *purely* for want of a symbol.  The bundled
#     libc is integer-only, has no POSIX extensions and no wide characters,
#     so some of the suite cannot link against it; the symbol each one wanted
#     is printed, because "not in this libc" is a property of the bundle and
#     "not in any libc" would be a fault in it.  Any other build error -- a missing header, a
#     linker script the driver cannot find, no libc at all -- is a real
#     failure and is reported as one, because that is what a broken bundle
#     looks like.
corpus_skips() {
  python3 "$SCRIPT_DIR/run-mc6809-tests" --list-skip 2>/dev/null | cut -f2
}

# A handful of the suite's programs are not plain programs: they want a
# particular start-up, or a sanitizer, or they are meant to fail.  meson knows
# this from test/meson.build; here it is four lines, each saying why.  If one
# goes stale the corpus reports a failure, which is the right way round.
corpus_flags() {
  case "$1" in
    # A host program: it uses pthreads and is built for the build machine.
    native-locks)      echo SKIP ;;
    # Checks that the minimal start-up does *not* run constructors, so it has
    # to be linked against that start-up.
    constructor-skip)  echo "-mcrt0=minimal" ;;
    # Wants -fsanitize=undefined and a runtime to trap into; we have neither.
    test-ubsan)        echo SKIP ;;
    # Two sources, as meson builds it.
    test-ilp32)        echo "$CORPUS/test-ilp32-sub.c" ;;
    *)                 echo "" ;;
  esac
}

# Programs whose job is to exit non-zero (meson's tests_should_fail).
corpus_inverted() {
  case "$1" in test-except|test-hosted-exit-fail) return 0 ;; esac
  return 1
}

run_corpus() {
  [ -d "$CORPUS" ] || { echo "FAIL corpus: no directory $CORPUS"; \
                        fail=$((fail + 1)); return; }
  skips=$(corpus_skips)
  [ -n "$skips" ] || { echo "FAIL corpus: run-mc6809-tests --list-skip said \
nothing; without it the run would report failures that are not failures"; \
                       fail=$((fail + 1)); return; }
  # Sources that other sources include are not programs of their own.
  included=$(cat "$CORPUS"/*.c 2>/dev/null \
             | sed -n 's/^#include "\(.*\.c\)"/\1/p' | sort -u)
  cok=0; cskip=0; cunsup=0; cfail=0; unsup_names=
  for src in "$CORPUS"/*.c; do
    [ -f "$src" ] || continue
    base=$(basename "$src"); name=${base%.c}
    echo "$included" | grep -qx "$base" && continue
    echo "$skips" | grep -qx "$name" && continue
    # Nor is a source without a main(): it is half of a test that meson links
    # with its other half.  Without this they fail to link and the run blames
    # the bundle for it.  A file that includes another source is a program
    # even so -- that is where its main() comes from.
    grep -qE '^(int[[:space:]]+)?main[[:space:]]*\(|^#include ".*\.c"' \
         "$src" || continue
    extra=$(corpus_flags "$name")
    [ "$extra" = SKIP ] && continue
    crt0=-mcrt0=semihost
    case "$extra" in *-mcrt0=*) crt0= ;; esac
    # shellcheck disable=SC2086
    if ! "$CLANG" --target=mc6809-unknown-unknown $crt0 $extra -Os \
          -I"$CORPUS" "$src" -o "$work/c.bin" > "$work/c.build" 2>&1; then
      if grep -q "undefined symbol" "$work/c.build" \
         && ! grep -qi "no such file\|cannot find\|not found\|unable to" \
                 "$work/c.build"; then
        why=$(sed -n 's/.*undefined symbol: \([A-Za-z_0-9]*\).*/\1/p' \
                 "$work/c.build" | head -1)
        cunsup=$((cunsup + 1)); unsup_names="$unsup_names $name($why)"
        continue
      fi
      echo "FAIL corpus/$name: did not build"
      sed 's/^/    /' "$work/c.build" | head -3
      cfail=$((cfail + 1)); continue
    fi
    $TIMEOUT "$USIM09BATCH" "$work/c.bin" >"$work/c.out" 2>&1 </dev/null
    rc=$?
    # A test that is supposed to fail has passed when it did.
    if corpus_inverted "$name"; then
      case "$rc" in 0) rc=1 ;; 124) ;; *) rc=0 ;; esac
    fi
    case "$rc" in
      0)   cok=$((cok + 1)) ;;
      77)  cskip=$((cskip + 1)) ;;
      124) echo "FAIL corpus/$name: did not terminate"; cfail=$((cfail + 1)) ;;
      *)   echo "FAIL corpus/$name: rc=$rc"
           tr -d '\000\r' < "$work/c.out" | sed '/^$/d' | tail -2 \
             | sed 's/^/    /'
           cfail=$((cfail + 1)) ;;
    esac
  done
  echo "corpus $CORPUS: ok=$cok skip=$cskip fail=$cfail unsupported=$cunsup"
  # Named with the symbol that was missing, not just counted.  The bundled
  # libc is built integer-only, without the POSIX extensions and without wide
  # characters, so some of the suite cannot link against it -- but which, and
  # for want of what, is the half of the number worth reading.
  [ -n "$unsup_names" ] && echo "  not in this libc:$unsup_names"
  pass=$((pass + cok)); fail=$((fail + cfail))
}

[ -n "$CORPUS" ] && run_corpus

echo "---"
echo "toolchain: $PREFIX"
# Which one was checked: a candidate that passes is only useful if the report
# says which candidate it was.
echo "version:   $("$CLANG" --version | head -1)"
echo "pass=$pass fail=$fail not-run=$notrun"
if [ "$env_error" -ne 0 ]; then
  if [ -n "${MC6809_CHECK_ALLOW_UNRUNNABLE:-}" ]; then
    # Somewhere that cannot have the machines -- CI, where a NitrOS-9 image
    # and a CoCo's ROMs cannot go.  The cases are still named as not run and
    # still counted, and the caller has said in advance that it is asking
    # for a smaller check.  What must never happen is the count vanishing.
    echo "$0: $notrun case(s) were not run; MC6809_CHECK_ALLOW_UNRUNNABLE" \
         "is set, so this is a pass over a reduced set -- not a full check" >&2
  else
    echo "$0: some cases could not be run, so this is not a pass" >&2
    exit 2
  fi
fi
[ "$fail" -eq 0 ]
