#!/bin/sh
#
# run-mc6809-os9 — picolibc test runner for OS-9 / NitrOS-9 on usim09pt.
#
# Usage: run-mc6809-os9 [--fp-module FILE] [--toolchain-ref FILE] <module>
#            [--stdin "string"] [--args "args"]
#        run-mc6809-os9 --batch LISTFILE [--fp-module FILE]
#
# The second form runs many programs from ONE boot.  LISTFILE holds a
# `name<TAB>path` per line; every program goes on the same disk and runs in
# turn, and the results come back on stdout as a stream:
#
#     @@@BEGIN <name>
#     ...whatever the program printed...
#     @@@END <name> rc=<status>
#
# A boot costs about two seconds and a program a few hundredths, which is
# the difference between an OS-9 test level being affordable and not.  If
# the run never reaches its sentinel -- something hung, or took the machine
# down -- the stream stops there and the caller re-runs what is missing one
# at a time.
#
# The program is an OS-9 program module (clang --target=mc6809-unknown-os9).
# Each run boots NitrOS-9 from the IDE image NITROS9_BOOT_DSK (i0) with the
# module on a fresh IDE image (j0), drives the shell over the console
# (scripted --input: log in, `chx /j0/cmds`, run the program, echo a
# sentinel), and relays the program's console output on stdout.  The exit
# status is the one the shell reports: NitrOS-9 prints `Error #nnn` for a
# non-zero F$Exit status, so that number is this script's exit code, 0
# otherwise -- which is what meson's test harness needs (77 = skip, 99 =
# error).  --stdin text follows the command line on the console, one line
# at a time; --args are the command's parameter words.
#
# Environment:
#   NITROS9_USIM09PT     the emulator (default: usim09pt on the path)
#   NITROS9_CPU          6809 (default) or 6309.  Picks the `l<level>_6309`
#                        recipe and runs the emulator as an HD6309.
#   NITROS9_LEVEL        1 or 2 (default 2).  The modules themselves are the
#                        same at either level -- U is the data base wherever
#                        the kernel puts it -- so a level is a boot image,
#                        not a build.
#   NITROS9_RECIPES      where the NitrOS-9 recipes live; with it set, the
#                        boot image and firmware follow from NITROS9_LEVEL
#                        (default ~/Documents/NitrOS-9/nitros9/recipes/picothing)
#   NITROS9_BOOT_DSK     a bootable NitrOS-9 IDE (flat) image; overrides the
#                        one NITROS9_LEVEL would pick
#   NITROS9_FIRMWARE     the Pico-Thing boot firmware (.srec); likewise
#   OS9_TOOL             ToolShed's os9 (default: os9 on the path)
#   NITROS9_INPUT_FIRST  cycles before the first console byte (login prompt
#                        up; default 78000000)
#   NITROS9_TIMEOUT      instruction cap for the whole run (default 2e9)
#   NITROS9_WALL_SECONDS wall-clock cap (default 600)
#   USIM_CYCLES=1        report `cycles=<N>` on stderr (the program's own
#                        instructions cannot be separated from the boot's;
#                        this is the whole run)
#   NITROS9_SETIME       date to set the guest clock to (default: the host's;
#                        `off` leaves the kernel's 1986 epoch)
#   NITROS9_USIM_EXTRA   extra usim09pt options (tracing, --brk-gated ...)
#   OS9_MAX_MODULE       largest module the system can give a data area to;
#                        the default follows NITROS9_LEVEL (see below).
#                        Anything bigger is reported E$MemFul (207) without
#                        being run
#   MC6809_FP_MODULE     the FPO9 floating-point module to put on the disk
#                        (the cross file passes --fp-module; a program doing
#                        floating point links it at start-up)
#   KEEP_OS9_WORKDIR=1   keep the per-run working directory
#

USIM="${NITROS9_USIM09PT:-usim09pt}"
OS9="${OS9_TOOL:-os9}"

# A run against a stale binary is worse than no run: it passes or fails for
# reasons that stopped being true when the compiler was rebuilt, and ninja
# has no edge from a test to the compiler that built it, so nothing else
# notices.  Refuse, and name the one command that fixes it.
check_freshness() {
  _ref="$1"; _bin="$2"
  [ "${MC6809_ALLOW_STALE:-0}" = 1 ] && return 0
  [ -n "$_ref" ] && [ -e "$_ref" ] && [ -e "$_bin" ] || return 0
  if [ "$_ref" -nt "$_bin" ]; then
    echo "$(basename "$0"): $(basename "$_bin") is older than the toolchain" >&2
    echo "  ($_ref has changed since it was built)" >&2
    echo "  run: scripts/mc6809-refresh <builddir>" >&2
    echo "  (MC6809_ALLOW_STALE=1 runs it anyway)" >&2
    exit 99
  fi
  return 0
}

stdin=""
args=""
module=""
fp_module="${MC6809_FP_MODULE:-}"
batch_list=""
toolchain_ref="${MC6809_TOOLCHAIN_REF:-}"
done=0
while [ $# -gt 0 -a $done -eq 0 ]; do
  case "$1" in
    --fp-module) fp_module="$2"; shift 2 ;;
    --batch)     batch_list="$2"; shift 2 ;;
    --toolchain-ref) toolchain_ref="$2"; shift 2 ;;
    --stdin)     stdin="$2";     shift 2 ;;
    --args)      args="$2";      shift 2 ;;
    *)
      if [ -z "$module" ]; then
        module="$1"; shift
      else
        done=1
      fi
      ;;
  esac
done


# ---------------------------------------------------------------------------
# Batch: one disk, one boot, every program in turn.
# ---------------------------------------------------------------------------
run_batch() {
  : "${NITROS9_TIMEOUT:=8000000000}"
  : "${NITROS9_WALL_SECONDS:=900}"
  : "${NITROS9_INPUT_FIRST:=78000000}"

  workdir=$(mktemp -d "${TMPDIR:-/tmp}/os9batch.XXXXXX")
  trap '[ "${KEEP_OS9_WORKDIR:-0}" = 1 ] || rm -rf "$workdir"' EXIT
  boot="$workdir/boot.dsk"; disk="$workdir/test.dsk"; log="$workdir/usim.log"
  cp "$NITROS9_BOOT_DSK" "$boot"
  "$OS9" format "$disk" -e -l16384 -q -nTEST >/dev/null
  "$OS9" makdir "$disk,CMDS" >/dev/null
  if [ -n "$fp_module" ] && [ -f "$fp_module" ]; then
    "$OS9" copy -r "$fp_module" "$disk,CMDS/FPO9" >/dev/null
    "$OS9" attr -q -e -pe -pr "$disk,CMDS/FPO9" >/dev/null
  fi

  # `echo` lives in the boot disk's command directory and chx moves us away
  # from it, so the marker after each program names it in full -- which
  # works at either level, where the shells agree on very little else.
  input="\\r\\r\\r"
  if [ "${NITROS9_SETIME:-auto}" != off ]; then
    setime=$NITROS9_SETIME
    [ "${setime:-auto}" = auto ] && setime=$(date "+%Y/%m/%d %H:%M:%S")
    input="${input}setime $setime\\r"
  fi
  input="${input}chx /j0/cmds\\rchd /j0\\r"
  names=""
  while IFS="	" read -r bname bpath; do
    [ -n "$bname" ] && [ -f "$bpath" ] || continue
    # A module too big to be given a data area takes the whole boot down
    # with it at Level 2 -- and everything after it in this batch.  Leave it
    # out; the caller will run it alone and be told E$MemFul at once.
    if [ "${OS9_MAX_MODULE:-0}" -gt 0 ]; then
      bsize=$(wc -c < "$bpath" | tr -d " ")
      [ "$bsize" -le "$OS9_MAX_MODULE" ] || continue
    fi
    # Same guard as a single run: a binary older than the toolchain is a
    # wrong answer waiting to happen.  Leave it out and the caller runs it
    # by itself, where the complaint reaches the tally as an error.
    if [ "${MC6809_ALLOW_STALE:-0}" != 1 ] && [ -n "$toolchain_ref" ] &&
       [ -e "$toolchain_ref" ] && [ "$toolchain_ref" -nt "$bpath" ]; then
      continue
    fi
    "$OS9" copy -r "$bpath" "$disk,CMDS/$bname" >/dev/null 2>&1 || continue
    "$OS9" attr -q -e -pe -pr "$disk,CMDS/$bname" >/dev/null 2>&1
    names="$names $bname"
    # Nothing may go between a program and its marker: a record starts at the
    # line the shell echoes for the program, which is recognised by ending in
    # the program's name, so any other command naming it would start a second
    # record and swallow the rest of the boot.
    input="${input}${bname}\\r/dd/cmds/echo @@@${bname}@@@\\r"
  done < "$batch_list"
  input="${input}/dd/cmds/echo CIDONE\\r"

  (cd "$workdir" && exec "$USIM" --timeout="$NITROS9_TIMEOUT" $_cpu_flag ${NITROS9_USIM_EXTRA:-} \
      --input-first="$NITROS9_INPUT_FIRST" --input-step=500000 \
      --input="$input" -f "$workdir/picothing.fram" \
      -d "$boot" -D "$disk" "$NITROS9_FIRMWARE" >"$log" 2>"$workdir/usim.err") &
  pid=$!
  waited=0
  while kill -0 "$pid" 2>/dev/null; do
    grep -aq 'CIDONE' "$log" 2>/dev/null && break
    [ "$waited" -ge "$NITROS9_WALL_SECONDS" ] && break
    sleep 1; waited=$((waited + 1))
  done
  # The emulator never stops on its own, and one left running holds a core
  # for as long as the machine is up -- which slows every later test enough
  # to look like a fault in the test.
  kill "$pid" 2>/dev/null || true
  sleep 1
  kill -9 "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null

  # What a program printed is what came between its own echoed command line
  # and its marker; its status is the shell's `Error #nnn` in that stretch.
  tr -d '\000' <"$log" | tr '\r' '\n' |
  awk -v names="$names" '
    BEGIN { n = split(names, want, " "); cur = ""; rc = 0 }
    {
      if (match($0, /@@@[A-Za-z0-9_]+@@@/)) {
        tok = substr($0, RSTART + 3, RLENGTH - 6)
        if (cur != "" && tok == cur) { printf "@@@END %s rc=%d\n", cur, rc; cur = ""; rc = 0 }
        next
      }
      if (cur == "") {
        for (i = 1; i <= n; i++)
          if (want[i] != "" && length($0) >= length(want[i]) &&
              substr($0, length($0) - length(want[i]) + 1) == want[i]) {
            cur = want[i]; rc = 0; printf "@@@BEGIN %s\n", cur; break
          }
        next
      }
      if ($0 ~ /^[Ee][Rr][Rr][Oo][Rr] #[0-9]+/) {
        s = $0; sub(/^[Ee][Rr][Rr][Oo][Rr] #0*/, "", s); sub(/[^0-9].*/, "", s)
        rc = s + 0; next
      }
      print
    }'
  grep -aq 'CIDONE' "$log" || return 124
  return 0
}

if [ -z "$module" ] && [ -z "$batch_list" ]; then
  echo "usage: run-mc6809-os9 <module> [--stdin string] [--args string]" >&2
  echo "       run-mc6809-os9 --batch listfile" >&2
  exit 99
fi

# The OS-9 runtime sits beside the floating-point module the cross file
# passes, so either one dates the toolchain the program was built against.
[ -n "$toolchain_ref" ] || [ -z "$fp_module" ] ||
  toolchain_ref="$(dirname "$fp_module")/libclang_rt.os9.a"
check_freshness "$toolchain_ref" "$module"

# A Level 2 task can map seven 8K blocks ($E000-$FFFF stays the kernel's),
# shared between the program, its data area and anything it links.  A module
# that needs all seven leaves nowhere for the data area -- and NitrOS-9 does
# not say so: the load wedges with no error and no prompt, and the run dies
# at the instruction cap minutes later.  Just under the line the kernel
# reports E$MemFul properly, so answer the same way at once rather than
# spend five minutes finding out.  Measured: 55568 bytes -> E$MemFul,
# 57568 -> wedge.
# Level 2 maps seven 8K blocks and, past that, wedges rather than
# reporting -- hence the gate.  Level 1 has no DAT: the program shares the
# one 64K space with the system, so the limit moves with what else is
# loaded, and the kernel says E$MemFul properly at every size (measured:
# 31804 runs, 35568 refused cleanly, 59565 refused cleanly).  So there is
# nothing to gate there, and a fixed number would be wrong anyway.
if [ "$NITROS9_LEVEL" = 2 ]; then
  : "${OS9_MAX_MODULE:=57344}"
else
  : "${OS9_MAX_MODULE:=0}"
fi
module_size=$(wc -c < "$module" | tr -d ' ')
if [ "$OS9_MAX_MODULE" -gt 0 ] && [ "$module_size" -gt "$OS9_MAX_MODULE" ]; then
  echo "$(basename "$0"): $(basename "$module") is $module_size bytes -- more" >&2
  echo "  than the $OS9_MAX_MODULE a task can map, so it cannot be given a data area" >&2
  exit 207
fi

# A level is a boot image, not a build: the same module runs at either.
: "${NITROS9_LEVEL:=2}"
: "${NITROS9_RECIPES:=$HOME/Documents/NitrOS-9/nitros9/recipes/picothing}"

# The processor is a boot image too.  A 6309 program needs a NitrOS-9 built
# for the 6309 -- not because of the module's language byte, which stays $11
# on both, but because the system's own code is assembled with the 6309
# instructions and the emulator has to be told to provide them.  The recipes
# name that build `l<level>_6309`.
: "${NITROS9_CPU:=6809}"
case "$NITROS9_CPU" in
  6809)        _cpudir= ;;
  6309|hd6309) NITROS9_CPU=6309; _cpudir=_6309 ;;
  *) echo "$(basename "$0"): NITROS9_CPU is 6809 or 6309, not $NITROS9_CPU" >&2
     exit 99 ;;
esac
[ "$NITROS9_CPU" = 6309 ] && _cpu_flag=--hd6309 || _cpu_flag=

_lvldir="$NITROS9_RECIPES/l${NITROS9_LEVEL}${_cpudir}"
if [ -z "${NITROS9_BOOT_DSK:-}" ] && [ -d "$_lvldir" ]; then
  # The 6809 recipes carry an `_x0` image built by an older top-level make;
  # a freshly built recipe has only the plain one.  Either boots.
  for _img in "$_lvldir/NOS9_${NITROS9_CPU}_L${NITROS9_LEVEL}_DEV_picothing_x0.dsk" \
              "$_lvldir/NOS9_${NITROS9_CPU}_L${NITROS9_LEVEL}_DEV_picothing.dsk"; do
    [ -f "$_img" ] && { NITROS9_BOOT_DSK=$_img; break; }
  done
fi
if [ -z "${NITROS9_FIRMWARE:-}" ] && [ -d "$_lvldir" ]; then
  NITROS9_FIRMWARE="$_lvldir/rel_picothing.srec"
fi
: "${NITROS9_BOOT_DSK:?need NITROS9_BOOT_DSK, or NITROS9_RECIPES + NITROS9_LEVEL}"
: "${NITROS9_FIRMWARE:?need NITROS9_FIRMWARE, or NITROS9_RECIPES + NITROS9_LEVEL}"

if [ -n "$batch_list" ]; then
  [ -r "$batch_list" ] || { echo "run-mc6809-os9: cannot read $batch_list" >&2; exit 99; }
  # Level 2 gives a task seven 8K blocks; Level 1 shares one address space
  # and says E$MemFul politely instead of wedging, so it needs no ceiling.
  if [ "${NITROS9_LEVEL:-2}" = 2 ]; then
    : "${OS9_MAX_MODULE:=57344}"
  else
    : "${OS9_MAX_MODULE:=0}"
  fi
  run_batch
  exit $?
fi
: "${NITROS9_INPUT_FIRST:=78000000}"
: "${NITROS9_TIMEOUT:=2000000000}"
: "${NITROS9_WALL_SECONDS:=600}"

# OS-9 command names: letters, digits, underscore; at most 29 characters.
name=$(basename "$module")
name=$(printf '%s' "$name" | tr -cd 'A-Za-z0-9_' | cut -c1-29)
[ -n "$name" ] || name=prog

workdir=$(mktemp -d "${TMPDIR:-/tmp}/os9run.XXXXXX")
cleanup() { [ "${KEEP_OS9_WORKDIR:-0}" = 1 ] || rm -rf "$workdir"; }
trap cleanup EXIT

boot="$workdir/boot.dsk"
disk="$workdir/test.dsk"
log="$workdir/usim.log"

cp "$NITROS9_BOOT_DSK" "$boot"
"$OS9" format "$disk" -e -l4096 -q -nTEST >/dev/null
"$OS9" makdir "$disk,CMDS" >/dev/null
"$OS9" copy -r "$module" "$disk,CMDS/$name" >/dev/null
"$OS9" attr -q -e -pe -pr "$disk,CMDS/$name" >/dev/null
# A program that does floating point links the FPO9 module at start-up and
# loads it from the execution directory when nothing else has it yet.
if [ -n "$fp_module" ] && [ -f "$fp_module" ]; then
  "$OS9" copy -r "$fp_module" "$disk,CMDS/FPO9" >/dev/null
  "$OS9" attr -q -e -pe -pr "$disk,CMDS/FPO9" >/dev/null
fi

# The console script: three CRs log in (the blank-name superuser), then
# the command, its stdin lines, and the sentinel.  Backslash-r sequences
# are usim09pt's notation; the command's own output is scraped between the
# command echo and the sentinel.
cmd="$name"
[ -n "$args" ] && cmd="$name $args"
input="\\r\\r\\r"
# The kernel's clock starts at its epoch (1986), which anything comparing
# time() against a modern date fails on; set it from the host unless told
# otherwise (NITROS9_SETIME=off).  Before chx, while the system commands are
# still the execution directory.
if [ "${NITROS9_SETIME:-auto}" != off ]; then
  setime=$NITROS9_SETIME
  [ "${setime:-auto}" = auto ] && setime=$(date "+%Y/%m/%d %H:%M:%S")
  input="${input}setime $setime\\r"
fi
input="${input}chx /j0/cmds\\rchd /j0\\r$cmd\\r"
if [ -n "$stdin" ]; then
  # Each stdin line becomes a console line; a trailing newline is implied.
  input="$input$(printf '%s' "$stdin" | sed 's/$/\\r/' | tr -d '\n')"
fi
input="${input}echo CIDONE\\r"

cycles_flag=""
[ "${USIM_CYCLES:-0}" = 1 ] && cycles_flag="--cycles"

(cd "$workdir" && exec "$USIM" --timeout="$NITROS9_TIMEOUT" $cycles_flag $_cpu_flag ${NITROS9_USIM_EXTRA:-} \
    --input-first="$NITROS9_INPUT_FIRST" --input-step=500000 \
    --input="$input" -f "$workdir/picothing.fram" \
    -d "$boot" -D "$disk" "$NITROS9_FIRMWARE" >"$log" 2>"$workdir/usim.err") &
pid=$!
waited=0
while kill -0 "$pid" 2>/dev/null; do
  if grep -aq 'CIDONE' "$log" 2>/dev/null; then
    break
  fi
  if [ "$waited" -ge "$NITROS9_WALL_SECONDS" ]; then
    break
  fi
  sleep 1
  waited=$((waited + 1))
done
# The emulator never stops on its own, and killing the shell that started it
# leaves it running: one left behind holds a core for as long as the machine
# is up, which slows every later test enough to look like a fault in the test.
kill "$pid" 2>/dev/null || true
wait "$pid" 2>/dev/null
usim_rc=$?

grep -a 'cycles=' "$workdir/usim.err" >&2 || true

if ! grep -aq 'CIDONE' "$log"; then
  # No sentinel: the run hung or the cap hit.  124 is the timeout
  # convention the tally harness understands.
  echo "run-mc6809-os9: NitrOS-9 run did not reach the sentinel ($name)" >&2
  tr -d '\000' <"$log" | tail -c 2000 >&2
  exit 124
fi

# The program's output: the console between the command echo and the
# sentinel command, without the NULs the console emits and with OS-9's CR
# line ends as newlines.  The shell's `Error #nnn` (after a failing
# command) gives the exit status; it is not part of the output.
out="$workdir/out.txt"
tr -d '\000' <"$log" | tr '\r' '\n' |
  awk -v cmd="$cmd" '
    # The shell prompt precedes the echoed command on the same line, so
    # match the line that ends with the command text, after the chd.
    state == 0 && index($0, "chd /j0") { state = 1; next }
    state == 1 { if (substr($0, length($0) - length(cmd) + 1) == cmd) state = 2; next }
    state == 2 { if (index($0, "echo CIDONE")) { exit } print }
  ' >"$out"
# The kernel's F$PErr says `ERROR #nnn`; Shell+ says `Error #nnn - text`.
status=0
if grep -q '^[Ee][Rr][Rr][Oo][Rr] #[0-9][0-9]*' "$out"; then
  status=$(grep '^[Ee][Rr][Rr][Oo][Rr] #[0-9][0-9]*' "$out" | tail -1 |
           sed 's/^[Ee][Rr][Rr][Oo][Rr] #0*\([0-9]*\).*/\1/')
  [ -n "$status" ] || status=1
fi
grep -v '^[Ee][Rr][Rr][Oo][Rr] #[0-9][0-9]*' "$out"
exit "$status"
