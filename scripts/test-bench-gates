#!/bin/bash
# test-bench-gates — can bench-parallel.sh's exit status actually fail, and does
# its lock stop a second bench without stopping anything else?
#
# Runs a copy of the bench in a sandbox, with a stub llvm-lit and its own
# ledger and logs.  It touches nothing outside its temporary directory: no real
# ledger, no cross files, no build directories.  It takes seconds, and is safe
# to run while a real bench is going.
#
# Usage: test-bench-gates [-k]      (-k keeps the sandbox for inspection)
set -u

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
KEEP=${1:-}
work=$(mktemp -d "${TMPDIR:-/tmp}/mc6809-bench-gates.XXXXXX")
stub=$work/stub
pico=$work/pico
repo=$work/repo
bin=$repo/llvm/build/bin

cleanup() { [ -n "$KEEP" ] || rm -rf "$work"; }
trap cleanup EXIT

mkdir -p "$stub" "$pico/scripts" "$bin" "$repo/llvm/test/CodeGen/MC6809" \
         "$repo/clang" "$work/usim"
cp "$SCRIPT_DIR/bench-parallel.sh" "$SCRIPT_DIR/run-mc6809-tests" \
   "$SCRIPT_DIR/create-bench-db.sh" "$SCRIPT_DIR/bench-db-schema.sql" "$pico/scripts/"
# The real lit check, from the llvm-mc6809 checkout beside this one, where the
# bench finds it: the bench's lit verdict is that script's.
llvm_repo=${LLVM_REPO:-$(cd "$SCRIPT_DIR/../.." && pwd)/llvm-mc6809}
mkdir -p "$repo/scripts"
cp "$llvm_repo/scripts/check-mc6809-lit.sh" "$repo/scripts/" || {
  echo "FAIL no scripts/check-mc6809-lit.sh in $llvm_repo"; exit 1; }
# The real generator writes cross files for whichever LLVM_BIN it is given.
printf '#!/bin/sh\nexit 0\n' > "$pico/scripts/gen-mc6809-cross.sh"
chmod +x "$pico/scripts/gen-mc6809-cross.sh"

cat > "$bin/llvm-lit" <<'EOF'
#!/bin/sh
# Stub lit: report whatever STUB_LIT_MODE asks for, and exit as lit would.
line() { echo "$1: stub :: stub/$1.ll (1 of 1)"; }
line PASS
case "${STUB_LIT_MODE:-pass}" in
  pass)       exit 0 ;;
  fail)       line FAIL; exit 1 ;;
  unresolved) line UNRESOLVED; exit 1 ;;
  timeout)    line TIMEOUT; exit 1 ;;
  xpass)      line XPASS; exit 1 ;;
  died)       exit 134 ;;
  spaces)
    echo "PASS: Suite With Spaces :: a.c (2 of 4)"
    echo "PASS: Suite With Spaces :: b.c (3 of 4)"
    echo "UNSUPPORTED: Suite With Spaces :: c.c (4 of 4)"
    exit 0 ;;
  samename)
    echo "PASS: One :: dir/same.s (2 of 3)"
    echo "PASS: Two :: dir/same.s (3 of 3)"
    exit 0 ;;
  quote)
    echo "PASS: stub :: it's.ll (2 of 2)"
    exit 0 ;;
  chatter)
    echo "FAIL: what a failing test printed"
    echo "PASS: printed :: by a test, with no count"
    exit 0 ;;
  duplicate)
    echo "PASS: stub :: twice.ll (2 of 3)"
    echo "PASS: stub :: twice.ll (3 of 3)"
    exit 0 ;;
  # Stay in the lit phase, when no test tool is running, until released.
  hold)
    echo $$ > "$STUB_DIR/lit-pid"
    n=0
    while [ ! -f "$STUB_DIR/lit-release" ] && [ $n -lt 600 ]; do
      sleep 0.1; n=$((n + 1))
    done
    exit 0 ;;
  # Be a child of the bench, which must be let through its parent's lock.
  child)
    "$PICO/scripts/run-mc6809-tests" --record --multi "none:$STUB_DIR/no-builddir" \
      > "$STUB_DIR/child.out" 2>&1
    exit 0 ;;
esac
EOF
chmod +x "$bin/llvm-lit"

passed=0 failed=0
bench_out=$work/bench.out

# Run the sandboxed bench with no levels to build or tally.
run_bench() {
  PICO="$pico" LLVM_REPO="$repo" LLVM_BIN="$bin" USIM="$work/usim" \
  MAME_RUNNER="$work/no-mame" MC6809_BENCH_DB="$work/ledger.sqlite" \
  MC6809_BENCH_LOG="$work/bench.log" MC6809_BENCH_LOCK="$work/bench.lock" \
  STUB_DIR="$stub" BENCH_LIT_MIN_PASS=${BENCH_LIT_MIN_PASS:-0} \
    "$pico/scripts/bench-parallel.sh" --skip-build --levels gate-test "$@" > "$bench_out" 2>&1
}

# check NAME WANTED_RC [TEXT_THE_OUTPUT_MUST_CONTAIN]
check() {
  local name=$1 want=$2 text=${3:-} rc=$4
  if [ "$rc" -ne "$want" ]; then
    echo "FAIL $name: exit $rc, wanted $want"; failed=$((failed + 1)); return
  fi
  if [ -n "$text" ] && ! grep -qF -- "$text" "$bench_out"; then
    echo "FAIL $name: output lacks '$text'"; failed=$((failed + 1)); return
  fi
  echo "ok   $name"; passed=$((passed + 1))
}

lit_case() { # NAME MODE WANTED_RC [TEXT]
  STUB_LIT_MODE=$2 run_bench
  check "$1" "$3" "${4:-}" $?
}

lit_case "lit passes"            pass       0
lit_case "lit FAIL"              fail       1 "GATE FAILED: lit check exited 1 (FAIL=1"
lit_case "lit UNRESOLVED"        unresolved 1 "UNRESOLVED=1"
lit_case "lit TIMEOUT"           timeout    1 "GATE FAILED: lit check exited 1"
lit_case "lit XPASS"             xpass      1 "GATE FAILED: lit check exited 1"
lit_case "lit dies with no tally" died      1 "GATE FAILED: lit check exited 134"
# The stub prints no lit summary, so it passes nothing a floor counts.
BENCH_LIT_MIN_PASS=1 run_bench
check "too few lit passes" 1 "GATE FAILED: lit check exited 1" $?

# --- What the lit phase records -----------------------------------------------

# ledger_case NAME MODE WANTED_ROWS: the rows of the newest lit run must be
# exactly WANTED_ROWS, one "STATUS test name" per line, after the stub's own PASS.
ledger_case() {
  local name=$1 mode=$2 want rows
  want=$(printf 'PASS stub :: stub/PASS.ll\n%b' "$3" | sort)
  STUB_LIT_MODE=$mode run_bench
  local rc=$?
  rows=$(sqlite3 "$work/ledger.sqlite" "SELECT status || ' ' || test_name FROM results
    WHERE run_id = (SELECT MAX(run_id) FROM runs WHERE opt_level = 'lit');" | sort)
  if [ "$rows" != "$want" ]; then
    echo "FAIL $name: the ledger holds:"; echo "$rows" | sed 's/^/       /'
    failed=$((failed + 1)); return
  fi
  check "$name" 0 "" "$rc"
}

ledger_case "a suite name with spaces keeps its test names" spaces \
  'PASS Suite With Spaces :: a.c\nPASS Suite With Spaces :: b.c\nUNSUPPORTED Suite With Spaces :: c.c\n'
ledger_case "one file name in two suites is two rows" samename \
  'PASS One :: dir/same.s\nPASS Two :: dir/same.s\n'
ledger_case "a quote in a test name is recorded" quote "PASS stub :: it's.ll\n"
ledger_case "what a test printed is not a result" chatter ''

lit_case "the ledger losing a lit result" duplicate 1 "GATE FAILED: the ledger kept 2 of 3 lit results"

mv "$bin/llvm-lit" "$bin/llvm-lit.off"
run_bench
check "lit missing from a build tree" 1 "GATE FAILED: lit did not run" $?
MC6809_TOOLCHAIN=$repo/llvm/build run_bench
check "lit missing from an installed toolchain" 0 "" $?
mv "$bin/llvm-lit.off" "$bin/llvm-lit"

# The check that was there first must still work.
mkdir -p "$repo/compiler-rt/test/mc6809-os9-runtime"
run_bench
check "OS-9 cases report nothing" 1 "GATE FAILED: the OS-9 runtime cases did not run" $?
rmdir "$repo/compiler-rt/test/mc6809-os9-runtime"

# --- The lock ---------------------------------------------------------------

# A bench left in the lit phase, holding the lock.  Sets holder.
start_holder() {
  rm -f "$stub/lit-pid" "$stub/lit-release"
  STUB_LIT_MODE=hold run_bench &
  holder=$!
  local n=0
  while [ ! -s "$stub/lit-pid" ] && [ $n -lt 300 ]; do sleep 0.1; n=$((n + 1)); done
  [ -s "$stub/lit-pid" ] || { echo "FAIL the holder bench never reached lit"; exit 1; }
}

run_standalone_tests() { # EXTRA_ENV...
  env "$@" PICO="$pico" MC6809_BENCH_DB="$work/ledger.sqlite" \
      MC6809_BENCH_LOCK="$work/bench.lock" \
    "$pico/scripts/run-mc6809-tests" --record --multi "none:$stub/no-builddir" \
    > "$bench_out" 2>&1
}

# Text alone must not block.  The old check matched this.
python3 -c 'import time; time.sleep(120)  # usim09batch run-mc6809-tests' &
decoy=$!
sleep 0.2
STUB_LIT_MODE=pass run_bench
check "a process that names the tools does not block" 0 "" $?
kill "$decoy" 2>/dev/null; wait "$decoy" 2>/dev/null

start_holder
# The holder must keep its own results; run the rivals into another file.
holder_out=$bench_out
bench_out=$work/rival.out

STUB_LIT_MODE=pass run_bench
check "a second bench is refused while no test tool runs" 1 "another bench is running" $?
if grep -qF "bench-parallel pid" "$bench_out"; then rc=0; else rc=1; fi
check "the refusal names the holder" 0 "" "$rc"

run_standalone_tests X=1
check "a standalone --record is refused" 1 "another bench is recording" $?

run_standalone_tests MC6809_BENCH_LOCK_FD=9
check "a stale inherited fd setting does not get past the lock" 1 "another bench is recording" $?

touch "$stub/lit-release"
wait "$holder"
rc=$?
bench_out=$holder_out
check "the bench holding the lock is unharmed" 0 "" "$rc"

STUB_LIT_MODE=child run_bench
rc=$?
cp "$stub/child.out" "$bench_out"
if grep -qF "another bench" "$bench_out" || ! grep -qF -- "--multi" "$bench_out"; then rc=9; fi
check "the bench's own harness gets through its lock" 0 "" "$rc"

run_standalone_tests X=1
if grep -qF "another bench" "$bench_out"; then rc=1; else rc=0; fi
check "a standalone --record runs once the lock is free" 0 "" "$rc"

# Killed outright, with a worker left behind that could still write.
start_holder
lit_pid=$(cat "$stub/lit-pid")
kill -9 "$holder" 2>/dev/null; wait "$holder" 2>/dev/null
bench_out=$work/rival.out
STUB_LIT_MODE=pass run_bench
check "a killed bench's surviving worker still holds the lock" 1 "another bench is running" $?
kill -9 "$lit_pid" 2>/dev/null
sleep 0.2
STUB_LIT_MODE=pass run_bench
check "nothing is left stale once they have all gone" 0 "" $?

# --- The tally ----------------------------------------------------------------

# A harness that records whatever STUB_TALLY asks for.
cat > "$pico/scripts/run-mc6809-tests" <<'EOF'
#!/bin/bash
while [ $# -gt 0 ]; do
  [ "$1" = --multi ] && { level=${2%%:*}; break; }
  shift
done
run_id=$(sqlite3 "$MC6809_BENCH_DB" "INSERT INTO runs (timestamp, opt_level)
  VALUES ('now', '$level'); SELECT last_insert_rowid();")
n=0
for status in OK $STUB_TALLY; do
  n=$((n + 1))
  sqlite3 "$MC6809_BENCH_DB" "INSERT INTO results (run_id, test_name, suite, status, opt_level)
    VALUES ($run_id, 'test$n', 'stub', '$status', '$level');"
done
exit "${STUB_TALLY_RC:-0}"
EOF
mkdir -p "$pico/builddir-mc6809-gate-test"
: > "$pico/builddir-mc6809-gate-test/build.ninja"
bench_out=$work/tally.out

tally_case() { # NAME STATUSES WANTED_RC [TEXT] [BENCH_ARGS...]
  local name=$1 statuses=$2 want=$3 text=${4:-}
  shift; shift; shift; [ $# -gt 0 ] && shift
  STUB_LIT_MODE=pass STUB_TALLY=$statuses run_bench "$@"
  check "$name" "$want" "$text" $?
}

tally_case "all OK"                       ""                0
tally_case "EXPECTEDFAIL passes"          "EXPECTEDFAIL"    0
tally_case "what never ran is not gated here" "SKIP BUILDFAIL TOOBIG OSLIMIT" 0
tally_case "one FAIL"                     "FAIL"            1 "GATE FAILED: gate-test had 1 FAIL"
tally_case "the failed test is named"     "FAIL"            1 "gate-test: 1 FAIL: test2"
tally_case "one TIMEOUT"                  "TIMEOUT"         1 "gate-test had 1 TIMEOUT"
tally_case "one ERROR"                    "ERROR"           1 "gate-test had 1 ERROR"
tally_case "one UNEXPECTEDPASS"           "UNEXPECTEDPASS"  1 "gate-test had 1 UNEXPECTEDPASS"
tally_case "every status is counted"      "FAIL FAIL TIMEOUT" 1 "gate-test had 2 FAIL; gate-test had 1 TIMEOUT"
tally_case "a FAIL fails a filtered run too" "FAIL"         1 "gate-test had 1 FAIL" --tests any
# The FAILs above are all in the ledger now.
tally_case "an earlier bench's FAIL does not count" ""      0

STUB_LIT_MODE=pass STUB_TALLY="" STUB_TALLY_RC=3 run_bench
check "a harness that fails" 1 "the tally harness exited 3" $?

# --- The commit a run records -------------------------------------------------

# lit_commit: the commit the newest lit run recorded.
lit_commit() {
  sqlite3 "$work/ledger.sqlite" "SELECT llvm_commit FROM runs
    WHERE run_id = (SELECT MAX(run_id) FROM runs WHERE opt_level = 'lit');"
}

# commit_case NAME WANTED: the newest lit run must have recorded WANTED.
commit_case() {
  local name=$1 want=$2 got
  STUB_LIT_MODE=pass STUB_TALLY="" run_bench
  local rc=$?
  got=$(lit_commit)
  if [ "$got" != "$want" ]; then
    echo "FAIL $name: recorded '$got', wanted '$want'"; failed=$((failed + 1)); return
  fi
  check "$name" 0 "" "$rc"
}

# A clean tree, committed long before its binaries were built.
git -C "$repo" init -q
echo source > "$repo/tracked"
git -C "$repo" add tracked
GIT_AUTHOR_DATE=2020-01-01T00:00:00Z GIT_COMMITTER_DATE=2020-01-01T00:00:00Z \
  git -C "$repo" -c user.name=t -c user.email=t@t commit -q -m tracked
head=$(git -C "$repo" rev-parse HEAD)
printf '#!/bin/sh\nexit 0\n' > "$bin/llc"
chmod +x "$bin/llc"

commit_case "a rebuild after the commit is not dirty" "$head"
echo changed >> "$repo/tracked"
commit_case "an uncommitted change is dirty" "$head+dirty"

echo "passed=$passed failed=$failed"
[ "$failed" -eq 0 ]
